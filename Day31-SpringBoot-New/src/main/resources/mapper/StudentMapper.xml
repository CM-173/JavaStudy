<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.day31springbootnew.mapper.StudentMapper">
    <select id="findByName" resultType="com.example.day31springbootnew.entity.Student">
        SELECT id, name, age
        FROM student
        WHERE name = #{name}
    </select>

    <select id="findAll" resultType="com.example.day31springbootnew.entity.Student">
        SELECT id, name, age
        FROM student
    </select>

    <insert id="insert">
        INSERT INTO student (name, age) VALUES (#{name}, #{age})
    </insert>

    <select id="findById" resultType="com.example.day31springbootnew.entity.Student">
        SELECT id, name, age FROM student WHERE id = #{id}
    </select>

    <update id="update">
        UPDATE student SET name = #{name}, age = #{age} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM student WHERE id = #{id}
    </delete>

    <select id="findPage" resultType="com.example.day31springbootnew.entity.Student">
        SELECT id, name, age FROM student LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="java.lang.Long">
        SELECT COUNT(*) FROM student
    </select>

    <sql id="searchCondition">
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="minAge != null">
                AND age &gt;= #{minAge}
            </if>
            <if test="maxAge != null">
                AND age &lt;= #{maxAge}
            </if>
        </where>
    </sql>

    <select id="search" resultType="com.example.day31springbootnew.entity.Student">
        SELECT id, name, age FROM student
        <include refid="searchCondition"/>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="java.lang.Long">
        SELECT COUNT(*) FROM student
        <include refid="searchCondition"/>
    </select>
</mapper>