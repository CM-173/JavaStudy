<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="Day13.com.student.mapper.StudentMapper">
    <!-- 根据id查询 -->
    <select id="findById"
            resultType="Day13.com.student.entity.Student">
        SELECT id,name,age
        FROM student
        WHERE id=#{id}
    </select>

    <!-- 查询所有 -->
    <select id="findAll"
            resultType="Day13.com.student.entity.Student">
        SELECT id,name,age
        FROM student
    </select>

    <!-- 添加学生 -->
    <insert id="insert">
        INSERT INTO student(id,name,age)
        VALUES(#{id},#{name},#{age})
    </insert>

    <!-- 修改学生 -->
    <update id="update">
        UPDATE student
        SET name=#{name},
        age=#{age}
        WHERE id=#{id}
    </update>

    <!-- 删除学生 -->
    <delete id="delete">
        DELETE FROM student
        WHERE id=#{id}
    </delete>

    <select id="search"
            resultType="Day13.com.student.entity.Student">
        SELECT *
        FROM student
        <where>
            <if test="name != null and name != ''">
                AND name=#{name}
            </if>

            <if test="age != null">
                AND age=#{age}
            </if>
        </where>
    </select>
</mapper>